<?xml version="1.0"?>
<launch>
  <!-- 启动多传感器MPU6050节点 -->
  <node pkg="multi_mpu6050" type="multi_mpu6050.py" name="multi_mpu6050_node" output="screen">
  </node>

  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu0_filter">
      <!-- 设置为true来使用磁力计数据。如果你的IMU没有或磁力计不可靠，设为false -->
      <param name="_use_mag" value="false"/>
      
      <!-- 滤波器启动时，会假设IMU处于静止状态来初始化零偏。
            这个参数设置了用于初始化的样本数量。-->
      <param name="_stateless" value="false"/>
      
      <!-- 陀螺仪零偏补偿的PI控制器增益。
            Kp (比例增益) - 决定了滤波器对加速度计/磁力计的信任程度。
            值越大，对加速度计的响应越快，但可能引入更多抖动。
            默认值是 0.1。这是一个很好的起点。-->
      <param name="_gain" value="0.1"/>
      
      <!-- Ki (积分增益) 的一个间接参数，用于控制陀螺仪零偏的抑制强度。
            设为0将禁用零偏补偿。值越大，对零偏的修正越强。
            默认值是 0.0。你需要将它设为一个较小的值来启用零偏补偿。-->
      <param name="_zeta" value="0.001"/>
      
      <!-- 输入: 你的IMU发布的原始数据话题 -->
      <remap from="/imu/data_raw" to="/imu0/data_raw"/>
      
      <!-- 输出: 滤波器处理后的、包含姿态信息的话题 -->
      <remap from="/imu/data" to="/imu0/data"/>
  </node>

  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu1_filter">
      <param name="_use_mag" value="false"/>
      <param name="_stateless" value="false"/>
      <param name="_gain" value="0.1"/>
      <param name="_zeta" value="0.001"/>
      <remap from="/imu/data_raw" to="/imu1/data_raw"/>
      <remap from="/imu/data" to="/imu1/data"/>
  </node>

  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu2_filter">
      <param name="_use_mag" value="false"/>
      <param name="_stateless" value="false"/>
      <param name="_gain" value="0.1"/>
      <param name="_zeta" value="0.001"/>
      <remap from="/imu/data_raw" to="/imu2/data_raw"/>
      <remap from="/imu/data" to="/imu2/data"/>
  </node>

  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu3_filter">
      <param name="_use_mag" value="false"/>
      <param name="_stateless" value="false"/>
      <param name="_gain" value="0.1"/>
      <param name="_zeta" value="0.001"/>
      <remap from="/imu/data_raw" to="/imu3/data_raw"/>
      <remap from="/imu/data" to="/imu3/data"/>
  </node>

  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu4_filter">
      <param name="_use_mag" value="false"/>
      <param name="_stateless" value="false"/>
      <param name="_gain" value="0.1"/>
      <param name="_zeta" value="0.001"/>
      <remap from="/imu/data_raw" to="/imu4/data_raw"/>
      <remap from="/imu/data" to="/imu4/data"/>
  </node>

  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu5_filter">
      <param name="_use_mag" value="false"/>
      <param name="_stateless" value="false"/>
      <param name="_gain" value="0.1"/>
      <param name="_zeta" value="0.001"/>
      <remap from="/imu/data_raw" to="/imu5/data_raw"/>
      <remap from="/imu/data" to="/imu5/data"/>
  </node>

  <!-- 可选：启动rviz可视化 -->
  <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find multi_mpu6050)/config/multi_imu_viz.rviz" required="false"/> -->
</launch> 
