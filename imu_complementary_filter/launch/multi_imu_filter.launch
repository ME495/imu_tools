<?xml version="1.0"?>
<!-- Example launch file for running multiple complementary filters for different IMUs -->
<launch>
  <!-- First IMU filter -->
  <node pkg="imu_complementary_filter" type="complementary_filter_node"
      name="imu1_filter_node" output="screen">
    <param name="do_bias_estimation" value="true"/>
    <param name="do_adaptive_gain" value="true"/>
    <param name="use_mag" value="true"/>
    <param name="gain_acc" value="0.01"/>
    <param name="gain_mag" value="0.01"/>
    <param name="input_topic" value="/imu1/data_raw"/>
    <param name="output_topic" value="/imu1/data"/>
    <param name="mag_topic" value="/imu1/mag"/>
  </node>

  <!-- Second IMU filter -->
  <node pkg="imu_complementary_filter" type="complementary_filter_node"
      name="imu2_filter_node" output="screen">
    <param name="do_bias_estimation" value="true"/>
    <param name="do_adaptive_gain" value="true"/>
    <param name="use_mag" value="true"/>
    <param name="gain_acc" value="0.01"/>
    <param name="gain_mag" value="0.01"/>
    <param name="input_topic" value="/imu2/data_raw"/>
    <param name="output_topic" value="/imu2/data"/>
    <param name="mag_topic" value="/imu2/mag"/>
  </node>

  <!-- Third IMU filter - example without magnetometer -->
  <node pkg="imu_complementary_filter" type="complementary_filter_node"
      name="imu3_filter_node" output="screen">
    <param name="do_bias_estimation" value="true"/>
    <param name="do_adaptive_gain" value="true"/>
    <param name="use_mag" value="true"/>
    <param name="gain_acc" value="0.01"/>
    <param name="input_topic" value="/imu3/data_raw"/>
    <param name="output_topic" value="/imu3/data"/>
  </node>
</launch> 